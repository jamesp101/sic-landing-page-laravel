APP_NAME="San Isidro College"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database. Default: the MariaDB that `devenv up` runs. For SQLite set DB_CONNECTION=sqlite and
# DB_DATABASE to an absolute file path.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sic
DB_USERNAME=sic
DB_PASSWORD=sic

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=noreply@sic.edu.ph
CONTACT_TO_ADDRESS=info@sic.edu.ph
MAIL_FROM_NAME="${APP_NAME}"

# Upload storage. STORAGE_DRIVER=local (default) or s3.
STORAGE_DRIVER=local
# local: files on disk under UPLOAD_DIR (relative to the project root, or absolute), served at /storage/*.
# In production use a persistent directory outside the deploy folder (e.g. /var/lib/sic/uploads).
UPLOAD_DIR=storage/uploads
# s3: any S3-compatible bucket. Credentials fall back to the AWS default chain when unset.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Optional key prefix inside the bucket, e.g. sic
S3_PREFIX=
# Optional public base URL of the bucket/CDN (bucket must be public-read); empty = stream through /storage/*.
S3_PUBLIC_URL=
# With s3, downloads (up to 20 MB) and videos (up to 100 MB) are uploaded by the browser through presigned
# PUT URLs, so the bucket needs a CORS rule allowing PUT with the Content-Type header from APP_URL.

# Behind a reverse proxy: comma-separated proxy addresses (or *) whose X-Forwarded-* headers are trusted.
TRUSTED_PROXIES=

# Seed passwords (never commit real ones).
SEED_SUPERADMIN_PASSWORD=password
SEED_DEPARTMENT_PASSWORD=password

VITE_APP_NAME="${APP_NAME}"
