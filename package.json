{
    "name": "sic-landing-page-laravel",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "check": "LARAVEL_BYPASS_ENV_CHECK=1 svelte-check --tsconfig ./tsconfig.json",
        "test": "vitest run",
        "e2e": "playwright test",
        "format": "prettier --write resources/js resources/css e2e",
        "format:check": "prettier --check resources/js resources/css e2e"
    },
    "dependencies": {
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/playfair-display": "^5.3.0",
        "@lucide/svelte": "^1.71.0",
        "bits-ui": "^2.19.5",
        "clsx": "^2.1.1",
        "cropperjs": "^2.3.0",
        "svelte": "^5.57.2",
        "svelte-dnd-action": "^0.9.80",
        "svelte-sonner": "^1.2.1",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.6.6"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@playwright/test": "1.63.0",
        "@sveltejs/vite-plugin-svelte": "^7.0.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.6.5",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.9.10",
        "prettier-plugin-svelte": "^3.4.0",
        "svelte-check": "^4.7.6",
        "typescript": "^6.0.3",
        "vite": "^8.0.0",
        "vitest": "^5.0.3"
    },
    "engines": {
        "node": ">=24"
    },
    "packageManager": "pnpm@10.18.0",
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild",
            "@tailwindcss/oxide"
        ]
    }
}
